# GraphQL Schema for Input Type Exerciser Tests
# This schema defines input types that will be used to test the code generator.
# The generated input types will be compared against manually built expected classes.

type Query {
  inputDefaults(count: Int = 42, name: String): String
  validate(
    count: Int!
    token: String!
    defaulted: Int! = 7
    nullable: String = "fallback"
    matrix: [[Int!]!]!
    loose: [[Int]]
    cube: [[[Int!]!]!]
    child: ValidationChild
    children: [ValidationChild!]
    choice: CopyChoice
  ): String
  firstOnly(first: Int!): ItemConnection
}

directive @connection on OBJECT
directive @edge on OBJECT

type Item {
  label: String
}
type ItemEdge @edge {
  node: Item
  cursor: String!
}
type ItemConnection @connection {
  edges: [ItemEdge!]!
  pageInfo: PageInfo!
}
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

input ValidationInput {
  count: Int!
  token: String!
  defaulted: Int! = 7
  nullable: String = "fallback"
  matrix: [[Int!]!]!
  loose: [[Int]]
  cube: [[[Int!]!]!]
  child: ValidationChild
  children: [ValidationChild!]
  choice: CopyChoice
}

input ValidationChild {
  count: Int!
  token: String! = "child-default"
}

"""
A simple input with basic fields.
"""
input SimpleInput {
  name: String
  count: Int = 42
}

"""
An input with a description to test Javadoc generation.
"""
input InputWithDescription {
  value: String
}

"""
An input with enum and list fields.
"""
input ComplexInput {
  status: StatusEnum
  tags: [String]
}

"""
An input with all field types.
"""
input AllFieldTypesInput {
  stringField: String
  intField: Int
  floatField: Float
  boolField: Boolean
  listField: [String]
  bigDecimalField: BigDecimal
  bigIntegerField: BigInteger
  jsonField: JSON
  jsonListField: [JSON]
}

scalar BigDecimal
scalar BigInteger
scalar JSON

"""
Enum for use in ComplexInput.
"""
enum StatusEnum {
  PENDING
  ACTIVE
  COMPLETED
}

input CopyChoice @oneOf {
  byName: String
  byEmail: String
}
