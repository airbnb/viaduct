+internal object TraversalFusionProbe {
+    private val objectVisits = linkedMapOf<String, IdentityHashMap<ObjectEngineResult, Int>>()
+    private val selections = IdentityHashMap<ObjectEngineResult, IdentityHashMap<SelectionForest, Int>>()
+    var demandKeys = 0L
+    var conformanceKeys = 0L
+    var selectionKeys = 0L
+    var checkedObjects = 0L
+    var replayLookups = 0L
+    var replayComputations = 0L
+    fun objectVisit(label: String, result: ObjectEngineResult) {
+        val byObject = objectVisits.getOrPut(label) { IdentityHashMap() }
+        byObject[result] = (byObject[result] ?: 0) + 1
+    }
+    fun selectionVisit(result: ObjectEngineResult, forest: SelectionForest) {
+        val byForest = selections.getOrPut(result) { IdentityHashMap() }
+        byForest[forest] = (byForest[forest] ?: 0) + 1
+    }
+    fun reset() {
+        objectVisits.clear(); selections.clear()
+        demandKeys = 0; conformanceKeys = 0; selectionKeys = 0; checkedObjects = 0; replayLookups = 0; replayComputations = 0
+    }
+    fun report() {
+        val demand = objectVisits.getValue("demand")
+        val conformance = objectVisits.getValue("conformance")
+        println("FUSION_PROBE demandObjects=${demand.values.sum()} uniqueDemandObjects=${demand.size} conformanceObjects=${conformance.values.sum()} uniqueConformanceObjects=${conformance.size} sharedObjects=${demand.keys.count { conformance.containsKey(it) }} demandKeys=$demandKeys conformanceKeys=$conformanceKeys")
+        println("FUSION_PROBE selectionObjects=${selections.values.sumOf { it.values.sum() }} uniqueObjectForestPairs=${selections.values.sumOf { it.size }} selectionKeys=$selectionKeys checkedObjects=$checkedObjects replayLookups=$replayLookups replayComputations=$replayComputations")
+    }
+}
